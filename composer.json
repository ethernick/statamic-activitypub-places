{
    "name": "ethernick/statamic-activitypub-places",
    "description": "ActivityPub Places, OpenStreetMap Geolocation, and Check-ins for Statamic 5.x and 6.x",
    "license": "proprietary",
    "type": "statamic-addon",
    "keywords": [
        "statamic",
        "statamic-addon",
        "activitypub",
        "places",
        "checkin",
        "openstreetmap",
        "nominatim",
        "geolocation",
        "fediverse",
        "mastodon",
        "cms"
    ],
    "homepage": "https://github.com/ethernick/statamic-activitypub-places",
    "authors": [
        {
            "name": "Nick Kempinski",
            "homepage": "https://github.com/ethernick",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ethernick/statamic-activitypub-places/issues",
        "source": "https://github.com/ethernick/statamic-activitypub-places",
        "docs": "https://github.com/ethernick/statamic-activitypub-places/docs"
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.0 | ^6.0",
        "ethernick/statamic-activitypub-core": "^0.9 || ^1.0 || dev-main"
    },
    "autoload": {
        "psr-4": {
            "Ethernick\\ActivityPubPlaces\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "ActivityPub Places",
            "description": "ActivityPub Places, OpenStreetMap Discovery, and Federated Check-ins"
        },
        "laravel": {
            "providers": [
                "Ethernick\\ActivityPubPlaces\\ActivityPubPlacesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
